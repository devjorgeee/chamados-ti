<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · HelpDesk TI</title>
  <meta name="description" content="Entre no HelpDesk TI com e-mail e senha ou com sua conta Google.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="bg-glow" aria-hidden="true"></div>

  <main class="auth-page">
    <section class="card auth-card">
      <div class="brand">
        <span class="brand-logo"><%- icon('zap', 20) %></span>
        <span class="brand-text">HelpDesk<strong>TI</strong></span>
      </div>
      <h1>Acesse sua conta</h1>
      <p class="subtitle">Entre para abrir e acompanhar chamados de TI.</p>

      <% if (!configurado) { %>
        <div class="alert alert-warn auth-msg" role="alert">
          <%- icon('alert') %>
          <div><strong>Firebase não configurado.</strong> Preencha o arquivo <code>firebase.config.json</code> com o <code>firebaseConfig</code> do seu projeto (veja o README).</div>
        </div>
      <% } %>

      <div class="alert auth-msg" id="auth-msg" role="alert" hidden></div>

      <form id="login-form" novalidate>
        <div class="field">
          <label for="email">E-mail</label>
          <input type="email" id="email" name="email" autocomplete="email" placeholder="voce@empresa.com" required autofocus>
        </div>
        <div class="field">
          <label for="senha">Senha</label>
          <input type="password" id="senha" name="senha" autocomplete="current-password" placeholder="Mínimo de 6 caracteres" minlength="6" required>
        </div>
        <div class="auth-actions">
          <button type="submit" class="btn btn-primary" id="btn-entrar">Entrar</button>
          <button type="button" class="btn btn-secondary" id="btn-cadastrar">Criar conta</button>
        </div>
      </form>

      <div class="auth-divider">ou</div>

      <button type="button" class="btn btn-google btn-block" id="btn-google">
        <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
          <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/>
          <path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
          <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/>
          <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C36.9 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/>
        </svg>
        Entrar com Google
      </button>

      <p class="auth-foot">Ao entrar, seus chamados ficam vinculados à sua conta.</p>
    </section>
  </main>

  <script type="module" src="/js/login.js"></script>
</body>
</html>
